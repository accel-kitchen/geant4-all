#------------------------------------------------------------------------------------
# sphericalDistributionTest.mac: 20m球面からの天頂角度分布テスト
# 原点中心の20m球面上の点から10m接円を通してミュオンを照射
# 高速版（可視化無効）
#------------------------------------------------------------------------------------

# パフォーマンス向上のための設定
/vis/disable
/tracking/verbose 0
/event/verbose 0
/run/verbose 0

# 天頂角分布を有効にする
/primaryGenerator/useZenithDistribution true



# 球面幾何学をテストするため、少数のイベントを実行
/run/beamOn 1000000000
